{
  "name": "@tempo/api",
  "private": true,
  "type": "module",
  "exports": {
    "./store": "./src/store/index.ts",
    "./public-data": "./src/public-data/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/lambda.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "load-demo": "tsx src/scripts/load-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1159.0",
    "@aws-sdk/client-secrets-manager": "3.1159.0",
    "@aws-sdk/client-sfn": "3.1159.0",
    "@aws-sdk/lib-dynamodb": "3.1159.0",
    "@tempo/pipeline": "*",
    "@tempo/shared": "*",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1159.0",
    "@hono/node-server": "2.1.8",
    "esbuild": "0.28.2"
  }
}
